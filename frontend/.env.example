# Somente para npm run dev em 127.0.0.1. Vite desabilita a sessão local no build.
VITE_CX_PDOH_DEMO_AUTH=true
VITE_CX_PDOH_BASE_PATH=/

# Em produção, configure login/sessão da aplicação hospedeira e um gateway autenticado.
# Nunca inclua token da API ou senha do MySQL em variáveis VITE_*.
# VITE_CX_PDOH_SESSION_URL=/auth/session
# VITE_CX_PDOH_LOGIN_URL=/auth/login
# VITE_CX_PDOH_LOGOUT_URL=/auth/logout
