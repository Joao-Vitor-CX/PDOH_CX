# Normaliza arquivos de automacao para LF, inclusive quando o projeto e editado no Windows.
* text=auto

*.sh          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.sql         text eol=lf
*.py          text eol=lf
*.ps1         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
Dockerfile    text eol=lf
.env.example  text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
.dockerignore  text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.xlsx  binary
