# Porta exposta no computador. Dentro da rede Docker o MySQL usa 3306.
PDOH_MYSQL_PORT=3307

# Copie este arquivo para .env e substitua todos os valores CHANGE_ME por
# segredos locais fortes. O arquivo .env real nao deve ser versionado.
PDOH_DB_USER=pdoh_cx_app
PDOH_DB_PASSWORD=CHANGE_ME_APP_PASSWORD

PDOH_MIGRATION_USER=pdoh_cx_migrator
PDOH_MIGRATION_PASSWORD=CHANGE_ME_MIGRATION_PASSWORD

# Credencial administrativa usada somente por MySQL e pelo bootstrap de usuarios.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
